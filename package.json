{
  "name": "@sfgov/design-system",
  "version": "3.0.0",
  "license": "MIT",
  "author": {
    "name": "sfds-bot",
    "url": "https://github.com/sfds-bot"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./formio": {
      "import": {
        "types": "./dist/formio/index.d.mts",
        "default": "./dist/formio/index.mjs"
      },
      "require": {
        "types": "./dist/formio/index.d.ts",
        "default": "./dist/formio/index.js"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset/index.d.mts",
        "default": "./dist/tailwind-preset/index.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset/index.d.ts",
        "default": "./dist/tailwind-preset/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "formio": [
        "./dist/formio/index.d.ts"
      ],
      "tailwind-preset": [
        "./dist/tailwind-preset/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "build-formio-css": "./scripts/build-formio-css.mjs",
    "build-tokens": "style-dictionary build --config ./sd.config.js",
    "clean": "rm -rf dist/",
    "lint": "eslint .",
    "figma-export": "figma-export use-config",
    "postbuild-tokens": "eslint --fix tokens",
    "postfigma-export": "eslint --fix components/icons",
    "prepublishOnly": "npm run build && npm run verify",
    "test": "jest --coverage",
    "watch": "npm run build-tokens && chokidar 'tokens/**/*.json' -c 'npm run build-tokens'",
    "watch-formio-css": "chokidar scripts/build-formio-css.mjs -c 'npm run build-formio-css'",
    "verify": "publint --strict && attw --pack"
  },
  "dependencies": {
    "@formio/react": "5.3.0",
    "@tw-classed/core": "^1.7.0",
    "@tw-classed/react": "^1.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^1.13.0",
    "vhtml": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@figma-export/cli": "^6.0.2",
    "@figma-export/output-components-as-svg": "^6.0.1",
    "@figma-export/output-components-as-svgr": "^6.0.1",
    "@figma-export/transform-svg-with-svgo": "^6.0.2",
    "@figma-export/types": "^6.0.0",
    "@formio/choices.js": "^10.2.1",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@thoughtbot/tailwindcss-aria-attributes": "^0.2.0",
    "@types/eslint": "^8.56.12",
    "@types/jest": "^29.4.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@types/ungap__structured-clone": "^1.2.0",
    "@types/vhtml": "^2.2.9",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "chokidar-cli": "^3.0.0",
    "cssnano": "^7.0.6",
    "cssnano-preset-advanced": "^7.0.6",
    "eslint": "^8.31.0",
    "eslint-config-next": "^13.1.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sfgov": "^2.0.0",
    "eslint-plugin-testing-library": "^5.10.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "formiojs": "^4.15.1",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-console": "^2.0.0",
    "moment": "^2.31.0",
    "node-factory": "^0.4.2",
    "postcss": "^8.5.18",
    "postcss-filter-rules": "^0.8.0",
    "postcss-import": "^16.1.0",
    "postcss-import-url": "^7.2.0",
    "postcss-prefix-selector": "^1.16.1",
    "prettier": "^2.8.8",
    "publint": "^0.3.25",
    "react-test-renderer": "18.2.0",
    "style-dictionary": "^3.7.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "~5.4.5"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
