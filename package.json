{
  "name": "@sfgov/design-system",
  "version": "1.0.0",
  "repository": "SFDigitalServices/design-system",
  "license": "MIT",
  "author": {
    "name": "sfds-bot",
    "url": "https://github.com/sfds-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./css/colors.css": "./dist/css/colors.css",
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./formio": {
      "import": {
        "types": "./dist/formio/index.d.mts",
        "default": "./dist/formio/index.mjs"
      },
      "require": {
        "types": "./dist/formio/index.d.ts",
        "default": "./dist/formio/index.js"
      }
    },
    "./formio/factories": {
      "import": {
        "types": "./dist/formio/factories/index.d.mts",
        "default": "./dist/formio/factories/index.mjs"
      },
      "require": {
        "types": "./dist/formio/factories/index.d.ts",
        "default": "./dist/formio/factories/index.js"
      }
    },
    "./formio/formio.css": "./dist/formio/formio.css",
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset/index.d.mts",
        "default": "./dist/tailwind-preset/index.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset/index.d.ts",
        "default": "./dist/tailwind-preset/index.js"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens/index.d.mts",
        "default": "./dist/tokens/index.mjs"
      },
      "require": {
        "types": "./dist/tokens/index.d.ts",
        "default": "./dist/tokens/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "formio": [
        "./dist/formio/index.d.ts"
      ],
      "formio/factories": [
        "./dist/formio/factories/index.d.ts"
      ],
      "tailwind-preset": [
        "./dist/tailwind-preset/index.d.ts"
      ],
      "tokens": [
        "./dist/tokens/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build-css": "tsx node_modules/postcss-cli/index.js src/css/*.css -d dist/css",
    "build-formio-css": "node scripts/build-formio-tailwind.mjs",
    "build": "npm run clean && tsup && npm run build-css && npm run build-formio-css",
    "clean": "rm -rf dist/",
    "figma-export": "figma-export use-config",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "postfigma-export": "eslint --fix src/react/icons",
    "prepublishOnly": "npm run build && npm run verify",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "publint --strict && attw --pack --exclude-entrypoints ./formio/formio.css ./css/colors.css",
    "watch": "chokidar --initial src '*.config.*' -c 'npm run build'"
  },
  "dependencies": {
    "@formio/react": "5.3.0",
    "@tw-classed/core": "^1.7.0",
    "@tw-classed/react": "^1.7.0",
    "tailwind-merge": "^1.13.0",
    "vhtml": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/npm": "^11.3.6",
    "@auto-it/omit-commits": "^11.3.6",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@figma-export/cli": "^6.0.2",
    "@figma-export/output-components-as-svg": "^6.0.1",
    "@figma-export/output-components-as-svgr": "^6.0.1",
    "@figma-export/transform-svg-with-svgo": "^6.0.2",
    "@figma-export/types": "^6.0.0",
    "@formio/choices.js": "^10.2.1",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@thoughtbot/tailwindcss-aria-attributes": "^0.2.0",
    "@types/jest": "^29.4.0",
    "@types/react": "18.2.0",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@types/ungap__structured-clone": "^1.2.0",
    "@types/vhtml": "^2.2.9",
    "auto": "^11.3.6",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "chokidar-cli": "^3.0.0",
    "cssnano": "^7.0.6",
    "cssnano-preset-advanced": "^7.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "formiojs": "^4.21.8",
    "globals": "^17.14.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-console": "^2.0.0",
    "moment": "^2.31.0",
    "node-factory": "^0.4.2",
    "postcss": "^8.5.18",
    "postcss-cli": "^12.0.0",
    "postcss-filter-rules": "^0.8.0",
    "postcss-import": "^16.1.0",
    "postcss-import-url": "^7.2.0",
    "postcss-prefix-selector": "^1.16.1",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "publint": "^0.3.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.72.1"
  }
}
