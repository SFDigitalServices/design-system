{
  "name": "@sfgov/design-system",
  "version": "3.1.1",
  "repository": "SFDigitalServices/design-system",
  "license": "MIT",
  "author": {
    "name": "sfds-bot",
    "url": "https://github.com/sfds-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src": "./src/index.ts",
    "#src/react": "./src/react/index.ts",
    "#src/react/icons": "./src/react/icons/index.ts",
    "#src/react/*": "./src/react/*.tsx",
    "#src/theme/*": "./src/theme/*.ts",
    "#src/tokens": "./src/tokens/index.ts",
    "#src/css/*": "./src/css/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./css/colors.css": "./dist/css/colors.css",
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset/index.d.mts",
        "default": "./dist/tailwind-preset/index.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset/index.d.ts",
        "default": "./dist/tailwind-preset/index.js"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens/index.d.mts",
        "default": "./dist/tokens/index.mjs"
      },
      "require": {
        "types": "./dist/tokens/index.d.ts",
        "default": "./dist/tokens/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "tailwind-preset": [
        "./dist/tailwind-preset/index.d.ts"
      ],
      "tokens": [
        "./dist/tokens/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build-css": "tsx node_modules/postcss-cli/index.js src/css/*.css -d dist/css",
    "build": "npm run clean && tsup && npm run build-css",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "clean": "rm -rf dist/",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm run verify",
    "storybook": "storybook dev -p 6006",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "publint --strict && attw --pack --exclude-entrypoints ./css/colors.css",
    "watch": "chokidar --initial src '*.config.*' -c 'npm run build'"
  },
  "dependencies": {
    "@tw-classed/react": "^1.7.0",
    "tailwind-merge": "^1.13.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/npm": "^11.3.6",
    "@auto-it/omit-commits": "^11.3.6",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^15.0.7",
    "@thoughtbot/tailwindcss-aria-attributes": "^0.2.0",
    "@types/jest": "^29.4.0",
    "@types/react": "18.2.0",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "auto": "^11.3.6",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "chokidar-cli": "^3.0.0",
    "chromatic": "^18.15.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "knip": "^6.45.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.18",
    "postcss-cli": "^12.0.0",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "publint": "^0.3.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.6.7",
    "storybook-addon-tag-badges": "^3.1.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
