{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "dom.iterable",
      "dom",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "dist",
    "resolveJsonModule": true,
  },
  "files": [
    "src/react/index.ts",
    "src/formio/index.tsx"
  ],
  "include": [
    "lib/**/*",
    "src/**/*",
    "*.config.*"
  ],
  "exclude": [
    "node_modules"
  ]
}